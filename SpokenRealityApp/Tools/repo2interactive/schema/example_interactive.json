                        "code_metadata": {
                          "code": "def get_parser() -> argparse.ArgumentParser:\n    \"\"\"Create and return the HTTPie argument parser.\"\"\"\n    parser = HTTPieArgumentParser(\n        prog='http',\n        description='HTTPie - a CLI HTTP client',\n        formatter_class=HTTPieHelpFormatter\n    )\n    \n    # Add positional arguments\n    parser.add_argument('method', nargs='?', default='GET')\n    parser.add_argument('url')\n    parser.add_argument('items', nargs='*')\n    \n    # Add optional arguments\n    parser.add_argument('--json', '-j', action='store_true')\n    parser.add_argument('--form', '-f', action='store_true')\n    # ... more arguments ...\n    \n    return parser",
