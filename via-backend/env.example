# Server
PORT=3000
NODE_ENV=development

# Database (Railway provides this in production)
DATABASE_URL=postgresql://postgres:password@localhost:5432/via_dev

# Clerk (Authentication)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# E2B (Code Sandboxes)
E2B_API_KEY=e2b_...

# OpenAI (Whisper for speech-to-text)
OPENAI_API_KEY=sk-...

# Anthropic (Claude for code generation)
ANTHROPIC_API_KEY=sk-ant-...

# xAI (Grok - optional, for TTS)
XAI_API_KEY=xai-...
